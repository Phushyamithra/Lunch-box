{
  "name": "lunchbox-meal-logger",
  "displayName": "LunchBox – Daily Meal Logger",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/gabarito": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/saira-condensed": "^5.3.0",
    "@fontsource/yeseva-one": "^5.3.0",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "@supabase/supabase-js": "^2.45.4",
    "dayjs": "^1.11.13",
    "framer-motion": "^11.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
