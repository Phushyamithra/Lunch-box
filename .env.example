# Web app (PWA) configuration. Copy to .env.local for local development and
# set the same two variables in Vercel → Project → Settings → Environment
# Variables. Both values are in Supabase → Project Settings → API.
#
# The anon key is designed to be public: Row Level Security policies (see
# supabase/migrations) are what restrict data to your account.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
