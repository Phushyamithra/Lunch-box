{
  "manifest_version": 3,
  "name": "LunchBox \u2013 Meal & Nutrition Tracker",
  "version": "1.4.0",
  "description": "Log daily meals with full nutrition info, track goals with achievements, view analytics, and sync logs to Google Tasks.",
  "key": "",
  "action": {
    "default_title": "Open LunchBox"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://tasks.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "oauth2": {
    "client_id": "967011441472-19qnk57hjt0sc8kar00in1889jnbc413.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/tasks",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  }
}